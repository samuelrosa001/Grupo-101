{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/unirse",
        "destination": "/bienvenida/",
        "type": 301
      },
      {
        "source": "/comunidad",
        "destination": "/bienvenida/",
        "type": 301
      }
    ]
  }
}
